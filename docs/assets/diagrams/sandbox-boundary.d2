direction: right
host: "Host" {
  ygg: "ygg (Odin)\ngit operations happen here"
  config: "hardened devcontainer config\nvalidated before every start"
  secrets: "~/.ssh, ~/.aws, git credentials,\nPodman socket"
}
sandbox: "Agent container: non-root user" {
  style.stroke: ${accent}
  style.stroke-width: 3
  agent: "agent CLI (pinned)"
  leaf: "one leaf working tree"
  token: "dedicated, revocable model token"
}
net: "Internet" {
  allowed: "model APIs and package registries\n(allowlist)"
  other: "everything else"
}
host.ygg -> sandbox.agent: "podman exec"
host.config -> sandbox: "--config, never mounted"
sandbox.agent -> net.allowed: "egress allowed"
sandbox.agent -> net.other: "blocked" {style.stroke: ${accent}; style.stroke-dash: 4}
sandbox -> host.secrets: "never mounted" {style.stroke: ${accent}; style.stroke-dash: 4}
