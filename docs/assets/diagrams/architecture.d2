direction: down
cli: "ygg CLI\nrun, resume, approve, status, metrics"
config: "factory.yaml\nmode, caps, roles, privacy"
realm: "realm-web\ngraph, prompts, checks, templates"
odin: "Odin\ngraph engine: exec, agent, loop, gate nodes"
jorm: "Jormungandr\nbuild, check, fix loop"
gleipnir: "Gleipnir (harness)" {
  agents: "agent adapters\nclaude-code, opencode, scripted"
  sandbox: "devcontainer driver\nPodman"
}
havamal: "Havamal\nvendored and own skills"
tree: "instance tree\numbrellas, leaves, ledger, gates"
gungnir: "Gungnir\nthe contract every component implements" {style.stroke-dash: 4}
cli -> odin
config -> odin
realm -> odin
